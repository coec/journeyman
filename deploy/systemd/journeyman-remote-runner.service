[Unit]
Description=Journeyman Remote Job Runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=journeyman
Group=journeyman
EnvironmentFile=/etc/journeyman/remote-runner.env
Environment=PATH=/opt/journeyman/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=ANSIBLE_SSH_CONTROL_PATH_DIR=/run/journeyman/ansible-cp
RuntimeDirectory=journeyman/ansible-cp
RuntimeDirectoryMode=0750
ExecStart=/opt/journeyman/venv/bin/python3 /opt/journeyman/bin/journeyman-remote-runner
Restart=on-failure
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/journeyman/remote-runner /var/lib/journeyman/remote-jobs /var/spool/journeyman/signals /opt/journeyman/environments /etc/journeyman/runner-pki

[Install]
WantedBy=multi-user.target
