#!/usr/bin/env python3
import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from journeyman_configuration import load_journeyman_configuration
load_journeyman_configuration()
from app import create_app, db
from app.models import ApiToken
from app.services.api_tokens import create_api_token


def main():
    parser = argparse.ArgumentParser(prog="journeyman-api-token")
    sub = parser.add_subparsers(dest="command", required=True)
    create = sub.add_parser("create")
    create.add_argument("--name", required=True)
    create.add_argument("--username", required=True)
    create.add_argument("--administrator", action="store_true")
    sub.add_parser("list")
    revoke = sub.add_parser("revoke")
    revoke.add_argument("name")
    args = parser.parse_args()
    app = create_app()
    with app.app_context():
        if args.command == "create":
            try:
                row, secret = create_api_token(name=args.name, username=args.username, administrator=args.administrator)
            except ValueError as exc:
                parser.error(str(exc))
            print("Created API token: {} ({})".format(row.name, row.username))
            print("Expires: {}".format(row.expires_at.isoformat()))
            print(secret)
            print("The token is displayed once; store it securely.")
        elif args.command == "list":
            for row in ApiToken.query.order_by(ApiToken.name.asc()).all():
                print("{}\t{}\t{}\t{}\t{}".format(
                    row.name, row.username, row.role,
                    "enabled" if row.enabled else "revoked",
                    row.expires_at.isoformat(),
                ))
        else:
            row = ApiToken.query.filter_by(name=args.name).one_or_none()
            if row is None:
                parser.error("API token was not found.")
            row.enabled = False
            db.session.commit()
            print("Revoked API token: {}".format(row.name))

if __name__ == "__main__":
    main()
