JOURNEYMAN_SERVER_URL=https://journeyman.example
JOURNEYMAN_RUNNER_UUID=replace-with-registered-runner-uuid
JOURNEYMAN_REMOTE_WORK_ROOT=/var/lib/journeyman/remote-jobs
JOURNEYMAN_REMOTE_POLL_SECONDS=5
JOURNEYMAN_REMOTE_CONTROL_SECONDS=2
# Optional custom CA bundle/file for private PKI. Leave unset to use system trust.
# JOURNEYMAN_CA_FILE=/etc/pki/ca-trust/source/anchors/journeyman-ca.crt
# Durable normalized Signal spool. rsyslog/syslog-ng remains responsible for
# receiving/parsing syslog; journeyman-signal-spool writes atomic JSON files here.
JOURNEYMAN_SIGNAL_SPOOL_ROOT=/var/spool/journeyman/signals
# v2 runner X.509 identity and inbound mTLS management listener.
JOURNEYMAN_RUNNER_PRIVATE_KEY=/etc/journeyman/runner-pki/replace.key.pem
JOURNEYMAN_RUNNER_CERTIFICATE=/etc/journeyman/runner-pki/replace.cert.pem
JOURNEYMAN_RUNNER_CA_CERTIFICATE=/etc/journeyman/runner-pki/replace.ca.pem
JOURNEYMAN_RUNNER_MANAGEMENT_PORT=8443
# JOURNEYMAN_RUNNER_MANAGEMENT_BIND=0.0.0.0
